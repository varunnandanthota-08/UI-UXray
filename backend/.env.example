# Server Port
PORT=5000

# MongoDB Database Connection URI (e.g., local MongoDB or MongoDB Atlas URI)
# Example local: mongodb://127.0.0.1:27017/barabari
# Example cloud: mongodb+srv://<username>:<password>@cluster.mongodb.net/barabari
MONGODB_URI=mongodb://127.0.0.1:27017/barabari

# JSON Web Token Secret Key for signing auth tokens
JWT_SECRET=your_secure_jwt_secret_key_here

# Frontend Application URLs for CORS whitelist
FRONTEND_URL=http://localhost:5173
FACILITATOR_URL=http://localhost:5173
